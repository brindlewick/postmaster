// --- C14 (spot half): no multi-word unquoted expansion stays in the blocks ---
async function coachmanQuoting(): Promise<void> {
  const doc = readFileSync(join(repoRoot, "skills", "postmaster", "coachman.md"), "utf8");
  const hits = ["$CLONE", "$REVIEWERS", "$NORMALIZE_FAILED"].filter((v) => doc.includes(v));
  if (hits.length > 0) fail(`unquoted expansions stay: ${hits.join(", ")}`);
}

// --- C15 (static half): every Bun start uses the running Bun's path ---
async function bunByPath(): Promise<void> {
  const hits: string[] = [];
  for (const file of ["host.ts", "launch.ts", "stage.ts", "fixture.ts"]) {
    const rel = `scripts/${file}`;
    const lines = readFileSync(join(repoRoot, rel), "utf8").split("\n");
    lines.forEach((line, i) => {
      if (line.includes("need(")) return;
      if (
        line.includes('"bun"') ||
        line.includes("'bun'") ||
        line.includes("&& bun ") ||
        line.includes("'bun ") ||
        line.includes('"bun ')
      ) {
        hits.push(`${rel}:${i + 1}: ${line.trim()}`);
      }
    });
  }
  if (hits.length > 0) fail(`Bun started by name:\n${hits.join("\n")}`);
}

// --- C15 (live half): a pane without Bun on PATH still runs its launch ---
async function tmuxRestrictedPath(): Promise<void> {
  if (!Bun.which("tmux")) {
    console.log("SKIP tmux-restricted-path: tmux not on PATH");
    return;
  }
  const dir = tmp("oracle-tmux-");
  const sockDir = join(dir, "sock");
  mkdirSync(sockDir, { recursive: true });
  const home = process.env.HOME ?? "";
  const srv = runSync(
    "env",
    ["-i", `HOME=${home}`, "PATH=/usr/bin:/bin", `TMUX_TMPDIR=${sockDir}`, "tmux", "new-session", "-d", "-s", "oraclesrv"],
    { timeoutMs: 15000 },
  );
  if (srv.code !== 0) fail(`restricted tmux server did not start: ${srv.err}`);
  const cwd = join(dir, "cwd");
  mkdirSync(cwd, { recursive: true });
  const env: Record<string, string | undefined> = {
    HOME: home,
    PATH: "/usr/bin:/bin",
    TMUX_TMPDIR: sockDir,
    POSTMASTER_HOST: "tmux",
    POSTMASTER_HOST_STATE: join(dir, "host"),
  };
  try {
    const mark = join(cwd, "t.done");
    const child = spawn(
      process.execPath,
      [
        "--no-env-file",
        `--config=${join(repoRoot, "bunfig.toml")}`,
        join(repoRoot, "scripts", "host.ts"),
        "run",
        "tmux-probe",
        cwd,
        "--out",
        join(cwd, "t.out"),
        "--err",
        join(cwd, "t.err"),
        "--marker",
        mark,
        "--",
        "sleep",
        "2",
      ],
      { env, stdio: ["ignore", "pipe", "pipe"] },
    );
    let out = "";
    let err = "";
    if (!child.stdout || !child.stderr) fail("spawned stdio missing");
    child.stdout.on("data", (d: Buffer) => (out += d.toString()));
    child.stderr.on("data", (d: Buffer) => (err += d.toString()));
    const code = await new Promise<number | null>((resolve) => {
      const timer = setTimeout(() => {
        try {
          child.kill("SIGKILL");
        } catch {
          // Gone.
        }
        resolve(null);
      }, 45000);
        child.on("close", (c) => {
        clearTimeout(timer);
        resolve(c);
      });
    });
    if (code !== 0) fail(`tmux run exit ${code}: ${out} ${err.slice(0, 400)}`);
    if (!out.includes("host=tmux")) fail(`expected host=tmux, got: ${out} ${err.slice(0, 200)}`);
    if (err.includes("running it in the background")) {
      fail(`pane fell back to the background: ${err.slice(0, 300)}`);
    }
    const landed = await pollTrue(() => existsSync(mark), 20000);
    if (!landed) fail("marker missing 20s after a 2s tmux launch ended");
  } finally {
    runSync("tmux", ["kill-server"], {
      env: { ...env, PATH: "/usr/bin:/bin" },
      timeoutMs: 15000,
    });
  }
}

