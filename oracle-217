#!/usr/bin/env bun
// Oracle for #217: blind acceptance tests at the ticket's interface, written before any
// lane's diff was read. Run from the repository root: ./oracle-217
//
// Each check exercises the ticket's own interface on Linux; forced checks set
// POSTMASTER_PROC_ROOT to a missing directory (D3), so postmaster takes its
// Mac path while Linux tools answer. Checks that need a Mac (C16, C17), a
// Herdr/tmux stub, or a live harness (C4, C8, the dying half of C3) are not
// here: the shipped tests cover those, and the checkpoint card says so.
import { spawn, spawnSync } from "node:child_process";
import {
  chmodSync,
  existsSync,
  mkdirSync,
  mkdtempSync,
  readdirSync,
  readFileSync,
  symlinkSync,
  utimesSync,
  writeFileSync,
} from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";

export const repoRoot = import.meta.dir;
const runEntry = join(repoRoot, "scripts", "run");
const sharesTs = join(repoRoot, "scripts", "synthesis-shares.ts");

export type Check = { name: string; timeoutMs: number; run: () => Promise<void> };

function fail(message: string): never {
  throw new Error(message);
}

function tmp(prefix: string): string {
  return mkdtempSync(join(tmpdir(), prefix));
}

function alive(pid: number): boolean {
  try {
    process.kill(pid, 0);
    return true;
  } catch {
    return false;
  }
}

function sleepMs(ms: number): Promise<void> {
  return new Promise<void>((resolve) => {
    setTimeout(() => resolve(), ms);
  });
}

async function pollTrue(
  ready: () => boolean,
  timeoutMs: number,
  stepMs = 250,
): Promise<boolean> {
  const end = Date.now() + timeoutMs;
  for (;;) {
    if (ready()) return true;
    if (Date.now() >= end) return false;
    await sleepMs(stepMs);
  }
}

type ProcOut = { code: number | null; out: string; err: string };

function runSync(
  cmd: string,
  args: string[],
  opts: { env?: Record<string, string | undefined>; cwd?: string; timeoutMs?: number },
): ProcOut {
  const r = spawnSync(cmd, args, {
    env: opts.env ?? process.env,
    cwd: opts.cwd,
    encoding: "utf8",
    timeout: opts.timeoutMs,
    maxBuffer: 4 * 1024 * 1024,
  });
  return { code: r.status, out: r.stdout ?? "", err: r.stderr ?? "" };
}

function killAll(pids: number[]): void {
  for (const pid of pids) {
    try {
      process.kill(pid, "SIGKILL");
    } catch {
      // Already gone.
    }
  }
}

function walkTs(dir: string): string[] {
  const found: string[] = [];
  for (const entry of readdirSync(dir, { withFileTypes: true })) {
    const p = join(dir, entry.name);
    if (entry.isDirectory()) found.push(...walkTs(p));
    else if (entry.isFile() && entry.name.endsWith(".ts")) found.push(p);
  }
  return found;
}

function launchRecordPids(stateDir: string): { record: number; members: number[] }[] {
  const out: { record: number; members: number[] }[] = [];
  const launches = join(stateDir, "launches");
  if (!existsSync(launches)) return out;
  for (const name of readdirSync(launches)) {
    const record = Number(name);
    if (!Number.isInteger(record)) continue;
    let members: number[] = [];
    try {
      const text = readFileSync(join(launches, name), "utf8");
      members = [...text.matchAll(/^member ([0-9]+)/gm)].map((m) => Number(m[1]));
    } catch {
      // Record vanished mid-read.
    }
    out.push({ record, members });
  }
  return out;
}

// --- C1: every process check goes through the one module under scripts/lib/ ---
//
// Non-test scripts outside scripts/lib must not read a pid's stat, list
// /proc, read another process's command line, call ps, or probe with
// kill(pid, 0). host-self-test.ts is a script, so it is included; its two
// kill-0 test assertions are excluded (kill-0 answers the same forced or
// not, so they are not Mac-path checks). A script's own /proc/self/cmdline
// and the boot-id/uptime reads of /proc/stat stay where they are (#259).
async function c01NoStrayProcChecks(): Promise<void> {
  const psCall = /\( *["']ps["'] *,/u;
  const psArray = /\[ *["']ps["'] *,/u;
  const kill0 = /process\.kill\([^()]*,[ ]*0[ ]*\)/u;
  const callOpen = /(readFileSync|readFile|accessSync|existsSync|statSync|openSync)\(/u;
  const listing = /readdir(Sync)?\(["']\/proc["']\)/u;
  const hits: string[] = [];
  for (const file of walkTs(join(repoRoot, "scripts"))) {
    const rel = file.slice(repoRoot.length + 1);
    if (rel.startsWith("scripts/lib/")) continue;
    if (rel.endsWith(".test.ts")) continue;
    if (rel.includes("oracle")) continue;
    const lines = readFileSync(file, "utf8").split("\n");
    lines.forEach((line, i) => {
      const at = `${rel}:${i + 1}`;
      const selfCmd = line.includes("/proc/self/cmdline");
      const bootStat =
        line.includes('"/proc/stat"') || line.includes("'/proc/stat'");
      const selfDir =
        line.includes('"/proc/self"') || line.includes("'/proc/self'");
      const staysFor259 =
        bootStat || selfDir || line.includes("boot_id") || line.includes("/proc/uptime");
      const rules: string[] = [];
      if (callOpen.test(line) && line.includes("/proc/") && !selfCmd && !staysFor259) {
        rules.push("pid-stat read");
      }
      if (listing.test(line)) rules.push("/proc listing");
      if (
        callOpen.test(line) &&
        line.includes("/proc/") &&
        line.includes("cmdline") &&
        !selfCmd
      ) {
        rules.push("foreign cmdline read");
      }
      if (psCall.test(line) || psArray.test(line)) rules.push("ps call");
      if (kill0.test(line) && !rel.endsWith("host-self-test.ts")) rules.push("kill-0 probe");
      if (rules.length > 0) hits.push(`${at} ${rules.join("+")}: ${line.trim()}`);
    });
  }
  if (hits.length > 0) fail(`${hits.length} stray process checks:\n${hits.join("\n")}`);
}

type BgLaunch = {
  env: Record<string, string | undefined>;
  cwd: string;
  state: string;
  mark: string;
  out: string;
  err: string;
};

function bgSetup(tag: string, forced: boolean): BgLaunch {
  const dir = tmp(`oracle-${tag}-`);
  const cwd = join(dir, "cwd");
  const state = join(dir, "host");
  const env: Record<string, string | undefined> = {
    ...process.env,
    POSTMASTER_HOST: "none",
    POSTMASTER_HOST_STATE: state,
  };
  if (forced) env.POSTMASTER_PROC_ROOT = join(dir, "no-such-proc");
  return {
    env,
    cwd,
    state,
    mark: join(cwd, "done.marker"),
    out: join(cwd, "out.log"),
    err: join(cwd, "err.log"),
  };
}

async function hostRun(
  bg: BgLaunch,
  name: string,
  cmd: string[],
): Promise<ProcOut> {
  mkdirSync(bg.cwd, { recursive: true });
  return await new Promise<ProcOut>((resolve) => {
    const child = spawn(
      runEntry,
      ["host", "run", name, bg.cwd, "--out", bg.out, "--err", bg.err, "--marker", bg.mark, "--", ...cmd],
      { env: bg.env, stdio: ["ignore", "pipe", "pipe"] },
    );
    let out = "";
    let err = "";
    if (!child.stdout || !child.stderr) fail("spawned stdio missing");
    child.stdout.on("data", (d: Buffer) => (out += d.toString()));
    child.stderr.on("data", (d: Buffer) => (err += d.toString()));
    const timer = setTimeout(() => {
      try {
        child.kill("SIGKILL");
      } catch {
        // Gone.
      }
      resolve({ code: null, out, err: `${err}\nORACLE: run host run timed out` });
    }, 30000);
    child.on("close", (code) => {
      clearTimeout(timer);
      resolve({ code, out, err });
    });
  });
}

// --- C2: the marker lands only once the launch's own process has ended ---
async function markerTiming(forced: boolean): Promise<void> {
  const bg = bgSetup(forced ? "mark-f" : "mark-u", forced);
  const r = await hostRun(bg, "mark-probe", ["sleep", "4"]);
  if (r.code !== 0) fail(`run host run exit ${r.code}: ${r.err}`);
  if (!r.out.includes("host=none")) fail(`expected host=none, got: ${r.out}`);
  const live = await pollTrue(() => launchRecordPids(bg.state).length > 0, 10000);
  if (!live) fail("launch never registered while it should be live");
  if (existsSync(bg.mark)) fail("marker already present while the launch lives");
  const landed = await pollTrue(() => existsSync(bg.mark), 15000);
  if (!landed) fail("marker missing 15s after a 4s launch ended");
  for (const rec of launchRecordPids(bg.state)) killAll([rec.record, ...rec.members]);
}

// --- C3 (live half): a running background launch is never "did not start" ---
async function bgStart(forced: boolean): Promise<void> {
  const bg = bgSetup(forced ? "bg-f" : "bg-u", forced);
  const r = await hostRun(bg, "bg-probe", ["sleep", "1"]);
  if (r.code !== 0) fail(`run host run exit ${r.code}: ${r.out} ${r.err}`);
  if (!r.out.includes("host=none")) fail(`expected host=none, got: ${r.out}`);
  if (r.err.includes("did not start")) fail(`live launch reported as not started: ${r.err}`);
  const landed = await pollTrue(() => existsSync(bg.mark), 10000);
  if (!landed) fail("marker missing 10s after a 1s launch ended");
  for (const rec of launchRecordPids(bg.state)) killAll([rec.record, ...rec.members]);
}

// --- C2 (zombie half): a zombie has ended; _watch touches its marker ---
async function zombieWatch(forced: boolean): Promise<void> {
  const dir = tmp(forced ? "oracle-z-f-" : "oracle-z-u-");
  const env: Record<string, string | undefined> = { ...process.env };
  if (forced) env.POSTMASTER_PROC_ROOT = join(dir, "no-such-proc");
  // The first child exits in 0.2s; its parent, exec'd into sleep, never reaps it.
  const parent = spawn("sh", ["-c", "sleep 0.2 & echo $!; exec sleep 30"], {
    stdio: ["ignore", "pipe", "ignore"],
  });
  let out = "";
  if (!parent.stdout) fail("helper stdout missing");
  parent.stdout.on("data", (d: Buffer) => (out += d.toString()));
  try {
    await sleepMs(1200);
    const zpid = Number((out.trim().split("\n")[0] ?? "").trim());
    if (!Number.isInteger(zpid) || zpid <= 0) fail(`no zombie pid from helper: ${JSON.stringify(out)}`);
    if (!alive(parent.pid ?? 0)) fail("helper parent died before the watch");
    const mark = join(dir, "zw.done");
    const watcher = spawn(runEntry, ["host", "_watch", String(zpid), mark], {
      env,
      stdio: "ignore",
    });
    try {
      const landed = await pollTrue(() => existsSync(mark), 10000);
      if (!landed) fail("zombie marker missing after 10s");
      if (!alive(parent.pid ?? 0)) fail("helper parent died during the watch");
    } finally {
      try {
        watcher.kill("SIGKILL");
      } catch {
        // Exited on its own.
      }
    }
  } finally {
    try {
      parent.kill("SIGKILL");
    } catch {
      // Gone.
    }
  }
}

// --- C5: the follower shows every line and exits only after the writer ---
async function followStream(forced: boolean): Promise<void> {
  const dir = tmp(forced ? "oracle-fol-f-" : "oracle-fol-u-");
  const file = join(dir, "events.jsonl");
  writeFileSync(file, "");
  const script = join(dir, "writer.sh");
  writeFileSync(
    script,
    '#!/usr/bin/env bash\nfor i in 1 2 3 4; do\nprintf \'{"type":"assistant","message":{"content":[{"type":"text","text":"step %d"}]}}\\n\' "$i" >> "$1"\nsleep 0.6\ndone\n',
  );
  const env: Record<string, string | undefined> = { ...process.env };
  if (forced) env.POSTMASTER_PROC_ROOT = join(dir, "no-such-proc");
  const writer = spawn("bash", [script, file], { stdio: "ignore" });
  try {
    const r = runSync(runEntry, ["view-stream", "--follow", file, "--pid", String(writer.pid)], {
      env,
      timeoutMs: 20000,
    });
    if (r.code !== 0) fail(`follow exit ${r.code}: ${r.err}`);
    for (const step of ["step 1", "step 2", "step 3", "step 4"]) {
      if (!r.out.includes(step)) fail(`follow missed ${step}: ${JSON.stringify(r.out)}`);
    }
  } finally {
    try {
      writer.kill("SIGKILL");
    } catch {
      // Finished.
    }
  }
}

// --- C6/C7: stop ends everything the launches started; close refuses while live ---
async function stopClose(forced: boolean): Promise<void> {
  const dir = tmp(forced ? "oracle-sc-f-" : "oracle-sc-u-");
  const cwd = join(dir, "cwd");
  mkdirSync(cwd, { recursive: true });
  const state = join(dir, "host");
  const env: Record<string, string | undefined> = {
    ...process.env,
    POSTMASTER_HOST: "none",
    POSTMASTER_HOST_STATE: state,
  };
  if (forced) env.POSTMASTER_PROC_ROOT = join(dir, "no-such-proc");
  const runLaunch = async (name: string, cmd: string[]): Promise<void> => {
    const bg: BgLaunch = {
      env,
      cwd,
      state,
      mark: join(cwd, `${name}.done`),
      out: join(cwd, `${name}.out`),
      err: join(cwd, `${name}.err`),
    };
    const r = await hostRun(bg, name, cmd);
    if (r.code !== 0) fail(`${name}: run host run exit ${r.code}: ${r.err}`);
  };
  await runLaunch("sleep-A", ["sleep", "300"]);
  const pidFile = join(cwd, "b.pid");
  const script = join(cwd, "b.sh");
  writeFileSync(script, `#!/usr/bin/env bash\nsleep 300 & echo $! > ${pidFile}\n`);
  await runLaunch("sleep-B", ["bash", script]);
  const registered = await pollTrue(() => launchRecordPids(state).length >= 2, 10000);
  if (!registered) fail("both launches never registered");
  const pidWritten = await pollTrue(() => existsSync(pidFile), 10000);
  if (!pidWritten) fail("launch B never started its background sleep");
  await sleepMs(1500);
  const before = launchRecordPids(state);
  if (before.length < 2) fail(`launches vanished before stop: ${JSON.stringify(before)}`);
  const bgPid = Number(readFileSync(pidFile, "utf8").trim());
  if (!Number.isInteger(bgPid) || bgPid <= 0) fail(`no background pid from launch B`);
  // _run records the background sleep as a member only once it has reaped
  // launch B's exited script; a scan before that deletes the record instead.
  // Wait for the member line, which is also the path the fix must keep working.
  await pollTrue(
    () => launchRecordPids(state).some((rec) => rec.members.includes(bgPid)),
    15000,
  );
  const withMember = launchRecordPids(state).some((rec) => rec.members.includes(bgPid));
  if (!withMember) fail("launch B's background sleep never recorded as a member");
  const liveBefore = [...before.map((rec) => rec.record), bgPid].filter((pid) => alive(pid));
  if (!alive(bgPid)) fail("launch B's background sleep not live before stop");
  if (liveBefore.length < 2) fail(`fewer than 2 launch pids live before stop: ${liveBefore}`);
  const unrelated = spawn("sleep", ["300"], { cwd, stdio: "ignore" });
  try {
    await sleepMs(500);
    const closeLive = runSync(runEntry, ["host", "close", cwd], {
      env: { ...env, POSTMASTER_HOST_CLOSE_WAIT: "1" },
      timeoutMs: 30000,
    });
    if (closeLive.code !== 2) {
      fail(`close while live exit ${closeLive.code}, want 2: ${closeLive.err}`);
    }
    if (!closeLive.err.includes("still running")) {
      fail(`close while live names no running launch: ${closeLive.err}`);
    }
    if (!closeLive.err.includes("sleep-A") || !closeLive.err.includes("sleep-B")) {
      fail(`close while live names fewer than both launches: ${closeLive.err}`);
    }
    const stopped = runSync(runEntry, ["host", "stop", cwd], {
      env: { ...env, POSTMASTER_HOST_STOP_WAIT: "5" },
      timeoutMs: 60000,
    });
    if (stopped.code !== 0) fail(`stop exit ${stopped.code}: ${stopped.err}`);
    if (!stopped.out.includes("2 launch(es)")) {
      fail(`stop did not act on both launches: ${stopped.out}`);
    }
    await sleepMs(1000);
    const stillLive = liveBefore.filter((pid) => alive(pid));
    if (stillLive.length > 0) fail(`launch pids survived stop: ${stillLive}`);
    if (!alive(unrelated.pid ?? 0)) fail("unrelated sleep in the same folder was stopped");
    const closeAfter = runSync(runEntry, ["host", "close", cwd], {
      env: { ...env, POSTMASTER_HOST_CLOSE_WAIT: "1" },
      timeoutMs: 30000,
    });
    if (closeAfter.code !== 0) fail(`close after stop exit ${closeAfter.code}: ${closeAfter.err}`);
  } finally {
    try {
      unrelated.kill("SIGKILL");
    } catch {
      // Gone.
    }
    killAll([bgPid]);
    for (const rec of launchRecordPids(state)) killAll([rec.record, ...rec.members]);
  }
}

// --- C9: runs-status reads a live lock as WAIT, whatever the start's form ---
function tickStartOf(pid: number): string {
  const stat = readFileSync(`/proc/${pid}/stat`, "utf8");
  const rest = stat.slice(stat.lastIndexOf(")") + 1).trim().split(/[ ]+/u);
  const start = rest[19] ?? "";
  if (!/^[0-9]+$/u.test(start)) fail(`no tick start for ${pid}`);
  return start;
}

function clocaleStartOf(pid: number): string {
  const r = runSync("ps", ["-o", "lstart=", "-p", String(pid)], {
    env: { ...process.env, LC_ALL: "C" },
    timeoutMs: 15000,
  });
  const words = r.out.trim().split(/[ ]+/u);
  if (words.length < 5) fail(`no five-word lstart for ${pid}: ${JSON.stringify(r.out)}`);
  return words.slice(0, 5).join(" ");
}

async function runsStatus(
  mode: "tick" | "clocale" | "foreign",
  forced: boolean,
): Promise<void> {
  const dir = tmp(`oracle-rs-${mode}-`);
  const root = join(dir, "runs");
  const d = join(root, "T");
  mkdirSync(join(d, "logs"), { recursive: true });
  const sleeper = spawn("sleep", ["60"], { stdio: "ignore" });
  try {
    await sleepMs(300);
    const pid = sleeper.pid ?? 0;
    if (!alive(pid)) fail("helper sleep died at once");
    const start =
      mode === "tick"
        ? tickStartOf(pid)
        : mode === "clocale"
          ? clocaleStartOf(pid)
          : "Mo Okt 05 12:00:00 2026";
    writeFileSync(join(d, ".leg-1-active"), `${pid} ${start}\n`);
    writeFileSync(
      join(d, "manifest.json"),
      JSON.stringify({ stage: "workhorses-running", leg: 1, base: "0".repeat(40) }),
    );
    writeFileSync(
      join(d, "logs", "coachman-leg-1-attempts.jsonl"),
      mode === "foreign" ? "not a record\n" : `${JSON.stringify({ attempt: 1, outcome: "started", role: "coachman" })}\n`,
    );
    const old = new Date(Date.now() - 3600 * 1000);
    for (const f of [
      join(d, "manifest.json"),
      join(d, "logs", "coachman-leg-1-attempts.jsonl"),
    ]) {
      utimesSync(f, old, old);
    }
    const env: Record<string, string | undefined> = { ...process.env };
    if (forced) env.POSTMASTER_PROC_ROOT = join(dir, "no-such-proc");
    const r = runSync(runEntry, ["runs-status", root], {
      env,
      timeoutMs: 30000,
    });
    if (r.code !== 0) fail(`runs-status exit ${r.code}: ${r.err}`);
    const row = r.out.split("\n").find((line) => line.startsWith("T "));
    if (!row) fail(`no run row in status output: ${JSON.stringify(r.out)}`);
    const want = mode === "foreign" ? "INSPECT" : "WAIT";
    if (!row.includes(want)) fail(`want ${want}, got row: ${JSON.stringify(row)}`);
    if (want === "WAIT" && row.includes("INSPECT")) {
      fail(`WAIT row also reads INSPECT: ${JSON.stringify(row)}`);
    }
  } finally {
    try {
      sleeper.kill("SIGKILL");
    } catch {
      // Gone.
    }
  }
}

// --- C10: shares agree with Apple's git, generated files excluded ---
async function sharesOldGit(): Promise<void> {
  const dir = tmp("oracle-shares-");
  const repo = join(dir, "repo");
  const home = join(dir, "home");
  mkdirSync(repo, { recursive: true });
  mkdirSync(home, { recursive: true });
  const gitEnv = {
    ...process.env,
    HOME: home,
    GIT_CONFIG_GLOBAL: "/dev/null",
    GIT_CONFIG_SYSTEM: "/dev/null",
  };
  const git = (args: string[]): ProcOut =>
    runSync("git", args, { env: gitEnv, cwd: repo, timeoutMs: 30000 });
  const line = (n: number): string =>
    `alpha beta gamma delta epsilon zeta eta theta line number ${n} with plenty of words`;
  git(["init", "-q", "-b", "main", "."]);
  git(["config", "user.email", "oracle@example.test"]);
  git(["config", "user.name", "oracle"]);
  writeFileSync(join(repo, ".gitattributes"), "*.gen linguist-generated\n");
  writeFileSync(join(repo, "a.txt"), `${line(1)}\n${line(2)}\n`);
  writeFileSync(join(repo, "b.gen"), `${line(1)}\n${line(2)}\n`);
  writeFileSync(join(repo, "d.md"), `${line(1)}\n${line(2)}\n`);
  git(["add", "-A"]);
  git(["checkout", "-qb", "work"]);
  git(["commit", "-qm", "base"]);
  const base = git(["rev-parse", "HEAD"]).out.trim();
  writeFileSync(join(repo, "a.txt"), `${line(1)}\n${line(2)}\n${line(3)} synthesis\n`);
  writeFileSync(join(repo, "b.gen"), `${line(1)}\n${line(2)}\n${line(3)} synthesis\n`);
  writeFileSync(join(repo, "d.md"), `${line(1)}\n${line(2)}\n${line(3)} synthesis\n`);
  git(["commit", "-qam", "synthesis"]);
  const synthesis = git(["rev-parse", "HEAD"]).out.trim();
  git(["checkout", "-qb", "lane"]);
  writeFileSync(join(repo, "a.txt"), `${line(1)}\n${line(2)}\n${line(3)} synthesis\n${line(4)} lane\n`);
  writeFileSync(join(repo, "b.gen"), `${line(1)}\n${line(2)}\n${line(3)} synthesis\n${line(4)} lane\n`);
  writeFileSync(join(repo, "d.md"), `${line(1)}\n${line(2)}\n${line(3)} synthesis\n${line(4)} lane\n`);
  git(["commit", "-qam", "lane"]);
  const lane = git(["rev-parse", "HEAD"]).out.trim();
  const sb = join(dir, "stubbin");
  mkdirSync(sb, { recursive: true });
  const realGit = Bun.which("git");
  if (!realGit) fail("git not on PATH");
  writeFileSync(
    join(sb, "git"),
    `#!/usr/bin/env bash\nfor a in "$@"; do\nif [ "$a" = "--source" ]; then echo "error: unknown option source" >&2; exit 129; fi\ndone\nexec "${realGit}" "$@"\n`,
  );
  chmodSync(join(sb, "git"), 0o755);
  const runShares = (record: string, withStub: boolean): ProcOut =>
    runSync(
      process.execPath,
      [
        "--no-env-file",
        "--config=/dev/null",
        sharesTs,
        "--base",
        base,
        "--synthesis",
        synthesis,
        "--lane",
        `test=${lane}`,
        "--record",
        record,
      ],
      {
        env: withStub ? { ...gitEnv, PATH: `${sb}:${process.env.PATH}` } : gitEnv,
        cwd: repo,
        timeoutMs: 60000,
      },
    );
  const recReal = join(dir, "rec-real");
  const recStub = join(dir, "rec-stub");
  mkdirSync(recReal, { recursive: true });
  mkdirSync(recStub, { recursive: true });
  const real = runShares(recReal, false);
  if (real.code !== 0) fail(`shares with real git exit ${real.code}: ${real.err}`);
  const stub = runShares(recStub, true);
  if (stub.code !== 0) fail(`shares with old git exit ${stub.code}: ${stub.err}`);
  if (real.out !== stub.out) {
    fail(`SHARES lines differ:\nreal: ${real.out}\nstub: ${stub.out}`);
  }
  const jsonReal = readFileSync(join(recReal, "shares.json"), "utf8");
  const jsonStub = readFileSync(join(recStub, "shares.json"), "utf8");
  if (jsonReal !== jsonStub) fail("shares.json differs between real and old git");
  if (!jsonReal.includes("b.gen") || !jsonReal.includes("marked generated by .gitattributes")) {
    fail(`generated file not excluded: ${jsonReal.slice(0, 500)}`);
  }
}

// --- C11: scoring needs git, bun and npm, but not jq ---
function toolBin(hide: string): string {
  const dir = tmp("oracle-toolbin-");
  for (const tool of ["git", "bun", "npm", "node", "env", "bash", "sh", "jq", "dirname"]) {
    if (tool === hide) continue;
    const found = tool === "bun" ? process.execPath : Bun.which(tool);
    if (!found) fail(`${tool} not on PATH, cannot build the tool bin`);
    symlinkSync(found, join(dir, tool));
  }
  return dir;
}

async function scoreWithout(hide: "jq" | "npm"): Promise<void> {
  const bin = toolBin(hide);
  const r = runSync(
    runEntry,
    ["fixture", "score", join(bin, "no-such-dispatch"), join(bin, "no-such-repo")],
    { env: { ...process.env, PATH: bin }, timeoutMs: 30000 },
  );
  const text = `${r.out}\n${r.err}`;
  if (hide === "npm") {
    if (r.code !== 1 || !text.includes("npm is not on PATH")) {
      fail(`hiding npm should fail naming npm, got exit ${r.code}: ${text.slice(0, 300)}`);
    }
    return;
  }
  if (text.includes("jq is not on PATH")) fail(`score still needs jq: ${text.slice(0, 300)}`);
  if (!text.includes("no such dispatch directory")) {
    fail(`score without jq should reach input checks, got exit ${r.code}: ${text.slice(0, 300)}`);
  }
}

// --- C12: the score's first line names system, Bun and git from live readings ---
async function platformLineApis(): Promise<void> {
  const src = readFileSync(join(repoRoot, "scripts", "fixture.ts"), "utf8");
  if (!src.includes("platform:")) fail("fixture.ts has no platform: line");
  const osImport = [...src.matchAll(/import \{[^}]*\} from "node:os"/gu)]
    .map((m) => m[0])
    .join("\n");
  const osNamespaces = [
    ...src.matchAll(/import \* as ([A-Za-z]+) from "node:os"/gu),
  ].map((m) => m[1] as string);
  const namespaced = (call: string): boolean =>
    osNamespaces.some((ns) => src.includes(`${ns}.${call}()`));
  const namesOsType =
    src.includes("os.type()") || /type as [A-Za-z]+/u.test(osImport) || namespaced("type");
  const namesRelease =
    src.includes("os.release()") || osImport.includes("release") || namespaced("release");
  const namesMachine =
    src.includes("os.machine()") || osImport.includes("machine") || namespaced("machine");
  if (!namesOsType || !namesRelease || !namesMachine) {
    fail("fixture.ts names no live os type/release/machine reading");
  }
  for (const api of ["Bun.version", "--version"]) {
    if (!src.includes(api)) fail(`fixture.ts has no ${api}`);
  }
}

// --- C13: the platform line cannot leak machine, user or home ---
async function platformNoLeak(): Promise<void> {
  const lines = readFileSync(join(repoRoot, "scripts", "fixture.ts"), "utf8").split("\n");
  const at = lines.findIndex((line) => line.includes("platform:"));
  if (at === -1) return; // C12 fails without the line; nothing to leak from.
  const window = lines.slice(Math.max(0, at - 40), at + 40).join("\n");
  for (const leak of [
    "os.hostname",
    "process.env.HOME",
    "process.env.USER",
    "process.env.LOGNAME",
    "homedir()",
  ]) {
    if (window.includes(leak)) fail(`platform-line window reads ${leak}`);
  }
}

// --- C11 (docs half): the requirements name Node and npm, not jq ---
async function readmeRequirements(): Promise<void> {
  const readme = readFileSync(join(repoRoot, "README.md"), "utf8");
