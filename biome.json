{
  "$schema": "./node_modules/@biomejs/biome/package.json",
  "root": true,
  "files": {
    "includes": [
      "scripts/**",
      "types/**",
      "lint/**",
      "package.json",
      "tsconfig.json",
      "biome.json",
      ".oxlintrc.json"
    ]
  },
  "overrides": [
    {
      "includes": ["scripts/fixtures/**"],
      "formatter": { "enabled": false }
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  }
}
